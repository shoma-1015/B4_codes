(* ====================================================================
   HammingWeight -- Hamming weight on F2[X]/(X^n - 1)

   Part of a small EasyCrypt library for code-based cryptography.
   Toolchain: EasyCrypt r2026.09, Alt-Ergo 2.6.0.

   This abstract theory is parameterised by the ring dimension n. It
   provides
     - the ring Rn = F2[X]/(X^n - 1), as a clone of the standard
       PolyReduceZp with p = 2 (in characteristic 2, X^n + 1 = X^n - 1);
     - the Hamming weight wt and the existence of elements of any weight;
     - an enumeration enumR of Rn and its finiteness;
     - uniform distributions on fixed-weight elements (dWt), on the error
       space E_t = { (e0, e1) : |e0| + |e1| = t } (dEt), and on the
       odd-weight elements (dRodd);
     - characteristic-2 facts (oppW, subW, rcoeffM2);
     - the parity homomorphism: ev1, the sum of the coefficients, is a ring
       homomorphism Rn -> F2, and parity x = wt x mod 2 = ev1 x; hence
       parity_add and parity_mul;
     - invertibility (section 8): PolyDiv cloned on the polynomials
       underlying Rn, coprime_unit (a representative coprime to X^n + 1
       gives a unit), X^n + 1 = (X + 1) * Phi, and wt_unit_irred (if n is
       odd and Phi = 1 + X + ... + X^(n-1) is irreducible, every element
       of odd weight < n is a unit).

   The only axiom of the theory is the clone parameter gt0_n : 0 < n.
   ==================================================================== *)

require import AllCore IntDiv List Distr Finite.
require PolyReduce PolyDiv.

(* -------------------------------------------------------------------- *)
(* Parameter: the ring dimension.                                        *)
op n : { int | 0 < n } as gt0_n.

(* -------------------------------------------------------------------- *)
(* 0. THE RING Rn = F2[X]/(X^n - 1)                                      *)
(* -------------------------------------------------------------------- *)
clone export PolyReduce.PolyReduceZp as PR with
  op Zp.p <- 2,
  op PolyReduce.n <- n
proof Zp.ge2_p by trivial,
      PolyReduce.gt0_n by exact gt0_n.
export PR.PolyReduce.

type Rn = polyXnD1.

(* -------------------------------------------------------------------- *)
(* 1. HAMMING WEIGHT                                                     *)
(* -------------------------------------------------------------------- *)

(* The number of nonzero coefficients among X^0, ..., X^(n-1). *)
op wt (x : Rn) : int = count (fun (i : int) => x.[i] <> Zp.zero) (range 0 n).

lemma wt_ge0 (x : Rn) : 0 <= wt x.
proof. by rewrite /wt count_ge0. qed.

lemma wt_le_n (x : Rn) : wt x <= n.
proof.
rewrite /wt; have := count_size (fun (i : int) => x.[i] <> Zp.zero) (range 0 n).
by rewrite size_range; smt(gt0_n).
qed.

(* polyLX is injective on coefficient lists of length n. *)
lemma polyLX_inj (s1 s2 : Zp.zmod list) :
  size s1 = n => size s2 = n => polyLX s1 = polyLX s2 => s1 = s2.
proof.
move=> h1 h2 heq.
apply (eq_from_nth Zp.zero); first by rewrite h1 h2.
move=> i hi.
rewrite -(polyLXE s1 i) 1:/# -(polyLXE s2 i) 1:/#.
by rewrite heq.
qed.

(* Witness factory: an element of any weight 0 <= k <= n exists, namely
   1 + X + ... + X^(k-1). *)
lemma weight_k_exists (k : int) :
  0 <= k <= n => exists (x : Rn), wt x = k.
proof.
move=> hk.
pose s := mkseq (fun (i : int) => if i < k then Zp.one else Zp.zero) n.
exists (polyLX s); rewrite /wt.
have -> : count (fun (i : int) => (polyLX s).[i] <> Zp.zero) (range 0 n)
        = count (fun (i : int) => i < k) (range 0 n).
+ apply eq_in_count => i /mem_range hi /=.
  rewrite polyLXE 1:size_mkseq 1:/#.
  rewrite nth_mkseq 1:/# /=.
  smt(Zp.oneE Zp.zeroE).
rewrite (range_cat k 0 n) 1,2:/# count_cat.
have -> : count (fun (i : int) => i < k) (range 0 k) = k.
+ have hall : all (fun (i : int) => i < k) (range 0 k).
  * by apply/allP => i /mem_range /#.
  by move/all_count: hall => ->; rewrite size_range /#.
have -> : count (fun (i : int) => i < k) (range k n) = 0.
+ have hno : !has (fun (i : int) => i < k) (range k n).
  * by apply/hasPn => i /mem_range /#.
  by smt(has_count count_ge0).
by [].
qed.

(* -------------------------------------------------------------------- *)
(* 2. ENUMERATION OF Rn                                                  *)
(* -------------------------------------------------------------------- *)

(* Rn is finite: this is the standard lemma finite_for_polyXnD1 applied
   to the full support of F2. *)
lemma finite_Rn : is_finite predT<:Rn>.
proof.
apply (finite_for_finite _ (map (pinject \o polyL)
          (alltuples n Zp.DZmodP.Support.enum))).
apply finite_for_polyXnD1; split.
+ exact Zp.DZmodP.Support.enum_uniq.
by move=> x; rewrite Zp.DZmodP.Support.enumP.
qed.

(* The enumeration is the canonical one attached to a finite type. *)
op enumR : Rn list = to_seq predT.

lemma enumR_uniq : uniq enumR.
proof. exact uniq_to_seq. qed.

lemma enumR_complete (x : Rn) : x \in enumR.
proof. by rewrite /enumR mem_to_seq 1:finite_Rn. qed.

lemma mem_enumR (x : Rn) : x \in enumR.
proof. exact enumR_complete. qed.

lemma enumR_spec (x : Rn) : count (pred1 x) enumR = 1.
proof. by rewrite count_uniq_mem 1:enumR_uniq enumR_complete. qed.

clone MFinite as RnFinite with
  type t <- Rn,
  op Support.enum <- enumR
proof Support.enum_spec by exact enumR_spec.

(* -------------------------------------------------------------------- *)
(* 3. FIXED-WEIGHT ELEMENTS                                              *)
(* -------------------------------------------------------------------- *)
op enumWt (k : int) : Rn list = filter (fun (x : Rn) => wt x = k) enumR.

op dWt (k : int) : Rn distr = duniform (enumWt k).

lemma mem_enumWt (k : int) (x : Rn) : x \in enumWt k <=> wt x = k.
proof. by rewrite /enumWt mem_filter mem_enumR. qed.

lemma supp_dWt (k : int) (x : Rn) : x \in dWt k <=> wt x = k.
proof. by rewrite /dWt supp_duniform mem_enumWt. qed.

lemma enumWt_nonempty (k : int) : 0 <= k <= n => enumWt k <> [].
proof.
move=> hk; have [x hx] := weight_k_exists k hk.
apply/negP => h.
by have := mem_enumWt k x; rewrite h hx.
qed.

lemma dWt_ll (k : int) : 0 <= k <= n => is_lossless (dWt k).
proof. by move=> hk; rewrite /dWt duniform_ll enumWt_nonempty. qed.

lemma dWt_uni (k : int) : is_uniform (dWt k).
proof. exact duniform_uni. qed.

(* -------------------------------------------------------------------- *)
(* 4. THE ERROR SPACE E_t                                                *)
(* -------------------------------------------------------------------- *)

(* E_t = { (e0, e1) in Rn x Rn : |e0| + |e1| = t }. *)
op inEt (t : int) (e : Rn * Rn) : bool = wt e.`1 + wt e.`2 = t.

op enumEt (t : int) : (Rn * Rn) list =
  filter (inEt t) (allpairs (fun (a b : Rn) => (a, b)) enumR enumR).

op dEt (t : int) : (Rn * Rn) distr = duniform (enumEt t).

lemma mem_enumEt (t : int) (e : Rn * Rn) : e \in enumEt t <=> inEt t e.
proof.
rewrite /enumEt mem_filter; split => [[] //| he]; split => //.
by apply/allpairsP; exists e; rewrite !mem_enumR /=; case: e he.
qed.

lemma Et_complete (t : int) (e : Rn * Rn) : inEt t e => e \in enumEt t.
proof. by rewrite mem_enumEt. qed.

lemma supp_dEt (t : int) (e : Rn * Rn) : e \in dEt t <=> inEt t e.
proof. by rewrite /dEt supp_duniform mem_enumEt. qed.

lemma Et_filter (t : int) (e : Rn * Rn) : e \in dEt t => inEt t e.
proof. by rewrite supp_dEt. qed.

(* Split t = min t n + (t - min t n); both parts lie in [0, n]. *)
lemma exists_inEt (t : int) : 0 <= t <= n + n => exists e, inEt t e.
proof.
move=> ht.
have [x0 hx0] := weight_k_exists (min t n) _; first smt(gt0_n).
have [x1 hx1] := weight_k_exists (t - min t n) _; first smt(gt0_n).
by exists (x0, x1); rewrite /inEt /= hx0 hx1 /#.
qed.

lemma enumEt_nonempty (t : int) : 0 <= t <= n + n => enumEt t <> [].
proof.
move=> ht; have [e he] := exists_inEt t ht.
apply/negP => h.
by have := mem_enumEt t e; rewrite h he.
qed.

lemma dEt_ll (t : int) : 0 <= t <= n + n => is_lossless (dEt t).
proof. by move=> ht; rewrite /dEt duniform_ll enumEt_nonempty. qed.

lemma dEt_uni (t : int) : is_uniform (dEt t).
proof. exact duniform_uni. qed.

(* -------------------------------------------------------------------- *)
(* 5. CHARACTERISTIC 2                                                   *)
(* -------------------------------------------------------------------- *)

(* Negation is the identity on F2. *)
lemma oppW (a : Zp.zmod) : Zp.([-]) a = a.
proof.
apply Zp.asint_inj; rewrite Zp.oppE.
smt(Zp.rg_asint).
qed.

(* Subtraction is addition on F2. *)
lemma subW (a b : Zp.zmod) : Zp.(-) a b = Zp.(+) a b.
proof. by rewrite oppW. qed.

(* BCA (BasePoly.BigCf) and BAdd (Zp.BigZMod) are the same fold. *)
lemma BCA_BAdd ['a] (P : 'a -> bool) (F : 'a -> Zp.zmod) (s : 'a list) :
  BasePoly.BigCf.BCA.big P F s = Zp.BigZMod.BAdd.big P F s.
proof. by rewrite /BasePoly.BigCf.BCA.big /Zp.BigZMod.BAdd.big. qed.

(* The coefficient formula rcoeffM in characteristic 2. *)
lemma rcoeffM2 (p q : Rn) (k : int) :
  0 <= k < n =>
  (p * q).[k]
  = Zp.BigZMod.BAdd.bigi predT
      (fun (i : int) => Zp.(+) (Zp.( * ) p.[i] q.[k - i])
                               (Zp.( * ) p.[i] q.[n + k - i])) 0 n.
proof.
move=> hk.
rewrite rcoeffM 1:// BCA_BAdd.
apply Zp.BigZMod.BAdd.eq_big_int => i hi /=.
by rewrite subW.
qed.

(* oner has exactly one nonzero coefficient, at index 0. *)
lemma rcoeff1 (k : int) : oner.[k] = if k = 0 then Zp.one else Zp.zero.
proof.
have h := rcoeff_polyXn 0 k _; first smt(gt0_n).
by move: h; rewrite ComRingDflInv.expr0.
qed.

lemma wt_oner : wt oner = 1.
proof.
rewrite /wt.
have -> : count (fun (i : int) => oner.[i] <> Zp.zero) (range 0 n)
        = count (pred1 0) (range 0 n).
+ apply eq_in_count => i /mem_range hi /=.
  rewrite rcoeff1.
  smt(Zp.oneE Zp.zeroE Zp.asint_eq).
rewrite count_uniq_mem 1:range_uniq mem_range.
smt(gt0_n).
qed.

(* -------------------------------------------------------------------- *)
(* 6. PARITY                                                             *)
(*                                                                       *)
(* parity is combinatorial (the number of nonzero coefficients mod 2)    *)
(* while ev1 is algebraic (the evaluation at 1). They are identified by  *)
(* parity_ev1, and ev1 is a ring homomorphism because the characteristic *)
(* is 2, so that parity is additive and multiplicative.                  *)
(* -------------------------------------------------------------------- *)
op parity (x : Rn) : int = wt x %% 2.

(* ev1: the sum of the coefficients, that is the evaluation at 1. *)
op ev1 (x : Rn) : Zp.zmod = Zp.BigZMod.BAdd.bigi predT (fun i => x.[i]) 0 n.

lemma ev1D (x y : Rn) : ev1 (x + y) = Zp.(+) (ev1 x) (ev1 y).
proof.
rewrite /ev1 -Zp.BigZMod.BAdd.big_split.
by apply Zp.BigZMod.BAdd.eq_big_int => i hi /=; rewrite rcoeffD.
qed.

(* Index shift for coefficient sums. *)
lemma big_shift (y : Rn) (i : int) :
  Zp.BigZMod.BAdd.bigi predT (fun (k : int) => y.[k - i]) 0 n
  = Zp.BigZMod.BAdd.bigi predT (fun (j : int) => y.[j]) (-i) (n - i).
proof.
have -> : Zp.BigZMod.BAdd.bigi predT (fun (j : int) => y.[j]) (-i) (n - i)
        = Zp.BigZMod.BAdd.bigi predT (fun (j : int) => y.[j]) (0 - i) (n - i).
+ by have -> : -i = 0 - i by smt().
rewrite (Zp.BigZMod.BAdd.big_addn 0 (n - i) (-i) predT (fun (j : int) => y.[j])).
have -> : n - i - -i = n by smt().
apply Zp.BigZMod.BAdd.eq_big => //= k.
qed.

(* For fixed 0 <= i < n, summing the two wrapped columns over k recovers
   the full coefficient sum of y. *)
lemma inner_sum (y : Rn) (i : int) :
  0 <= i < n =>
  Zp.BigZMod.BAdd.bigi predT
    (fun (k : int) => Zp.(+) y.[k - i] y.[n + k - i]) 0 n
  = ev1 y.
proof.
move=> hi.
have hL : Zp.BigZMod.BAdd.bigi predT (fun (k : int) => y.[k - i]) 0 n
        = Zp.BigZMod.BAdd.bigi predT (fun (j : int) => y.[j]) 0 (n - i).
+ rewrite (big_shift y i).
  rewrite (Zp.BigZMod.BAdd.big_cat_int 0 (-i) (n - i)) 1,2:/#.
  rewrite (Zp.BigZMod.BAdd.big1_seq predT _ (range (-i) 0)).
  + by move=> j [_ /mem_range hj] /=; rewrite lt0_rcoeff 1:/#.
  by rewrite Zp.ZModpRing.add0r.
have hR : Zp.BigZMod.BAdd.bigi predT (fun (k : int) => y.[n + k - i]) 0 n
        = Zp.BigZMod.BAdd.bigi predT (fun (j : int) => y.[j]) (n - i) n.
+ have -> : Zp.BigZMod.BAdd.bigi predT (fun (k : int) => y.[n + k - i]) 0 n
          = Zp.BigZMod.BAdd.bigi predT (fun (k : int) => y.[k - (i - n)]) 0 n.
  + by apply Zp.BigZMod.BAdd.eq_big_int => k hk /=; congr; smt().
  rewrite (big_shift y (i - n)).
  have -> : -(i - n) = n - i by smt().
  have -> : n + (n - i) = 2 * n - i by smt().
  rewrite (Zp.BigZMod.BAdd.big_cat_int n (n - i) (2 * n - i)) 1,2:/#.
  rewrite (Zp.BigZMod.BAdd.big1_seq predT _ (range n (2 * n - i))).
  + by move=> j [_ /mem_range hj] /=; rewrite gered_rcoeff 1:/#.
  by rewrite Zp.ZModpRing.addr0.
rewrite (Zp.BigZMod.BAdd.big_split predT
          (fun (k : int) => y.[k - i])
          (fun (k : int) => y.[n + k - i])
          (range 0 n)).
rewrite hL hR /ev1.
by rewrite -(Zp.BigZMod.BAdd.big_cat_int (n - i) 0 n) 1,2:/#.
qed.

(* ev1 is multiplicative: evaluation at 1 is a ring homomorphism. *)
lemma ev1M (x y : Rn) : ev1 (x * y) = Zp.( * ) (ev1 x) (ev1 y).
proof.
have step1 : ev1 (x * y)
  = Zp.BigZMod.BAdd.bigi predT
      (fun (k : int) =>
         Zp.BigZMod.BAdd.bigi predT
           (fun (i : int) => Zp.(+) (Zp.( * ) x.[i] y.[k - i])
                                    (Zp.( * ) x.[i] y.[n + k - i])) 0 n) 0 n.
+ rewrite /ev1.
  by apply Zp.BigZMod.BAdd.eq_big_int => k hk /=; exact (rcoeffM2 x y k hk).
have step2 : ev1 (x * y)
  = Zp.BigZMod.BAdd.bigi predT
      (fun (i : int) => Zp.( * ) x.[i] (ev1 y)) 0 n.
+ rewrite step1 Zp.BigZMod.BAdd.exchange_big.
  apply Zp.BigZMod.BAdd.eq_big_int => i hi /=.
  have -> : Zp.BigZMod.BAdd.bigi predT
              (fun (k : int) => Zp.(+) (Zp.( * ) x.[i] y.[k - i])
                                       (Zp.( * ) x.[i] y.[n + k - i])) 0 n
          = Zp.BigZMod.BAdd.bigi predT
              (fun (k : int) => Zp.( * ) x.[i] (Zp.(+) y.[k - i] y.[n + k - i])) 0 n.
  + by apply Zp.BigZMod.BAdd.eq_big_int => k hk /=;
       rewrite Zp.ZModpRing.mulrDr.
  rewrite -(Zp.BigZMod.BAdd.mulr_sumr predT
             (fun (k : int) => Zp.(+) y.[k - i] y.[n + k - i])
             (range 0 n) x.[i]).
  by rewrite (inner_sum y i hi).
rewrite step2.
rewrite -(Zp.BigZMod.BAdd.mulr_suml predT
           (fun (i : int) => x.[i]) (range 0 n) (ev1 y)).
by rewrite /ev1.
qed.

(* asint of a coefficient sum = (number of nonzero coefficients) mod 2. *)
lemma asint_big_count (x : Rn) (a b : int) :
  Zp.asint (Zp.BigZMod.BAdd.bigi predT (fun i => x.[i]) a b)
  = count (fun (i : int) => x.[i] <> Zp.zero) (range a b) %% 2.
proof.
have [k [hk hab]] : exists k, 0 <= k /\ b - a <= k.
+ by exists (max 0 (b - a)); smt().
elim: k hk a b hab => [| k hk ih] a b hab.
+ rewrite Zp.BigZMod.BAdd.big_geq 1:/# range_geq 1:/#.
  by rewrite Zp.zeroE.
case (b <= a) => hba.
+ rewrite Zp.BigZMod.BAdd.big_geq 1:/# range_geq 1:/#.
  by rewrite Zp.zeroE.
have hlt : a < b by smt().
rewrite (Zp.BigZMod.BAdd.big_ltn a b) 1:// (range_ltn a b) 1:// /=.
rewrite Zp.addE (ih (a + 1) b) 1:/#.
smt(Zp.rg_asint Zp.zeroE Zp.asint_eq modzDml modzDmr).
qed.

lemma parity_ev1 (x : Rn) : parity x = Zp.asint (ev1 x).
proof. by rewrite /parity /wt /ev1 asint_big_count. qed.

lemma parity_range (x : Rn) : 0 <= parity x < 2.
proof. rewrite /parity; smt(modz_ge0 ltz_pmod). qed.

lemma parity_add (x y : Rn) :
  parity (x + y) = (parity x + parity y) %% 2.
proof. by rewrite !parity_ev1 ev1D Zp.addE. qed.

lemma parity_mul (x y : Rn) :
  parity (x * y) = (parity x * parity y) %% 2.
proof. by rewrite !parity_ev1 ev1M Zp.mulE. qed.

lemma parity_oner : parity oner = 1.
proof. by rewrite /parity wt_oner. qed.

(* The inverse of an odd unit is odd:
   1 = parity (x * invr x) = parity x * parity (invr x) mod 2. *)
lemma parity_invr (x : Rn) :
  ComRingDflInv.unit x => parity x = 1 => parity (ComRingDflInv.invr x) = 1.
proof.
move=> hu hx.
have h1 : parity (x * ComRingDflInv.invr x) = 1.
+ by rewrite ComRingDflInv.mulrV 1:// parity_oner.
have := parity_mul x (ComRingDflInv.invr x).
rewrite h1 hx /=.
smt(parity_range).
qed.

(* -------------------------------------------------------------------- *)
(* 7. ODD-WEIGHT ELEMENTS R_odd                                          *)
(* -------------------------------------------------------------------- *)
op enumRodd : Rn list = filter (fun (x : Rn) => parity x = 1) enumR.

op dRodd : Rn distr = duniform enumRodd.

lemma supp_dRodd (x : Rn) : x \in dRodd <=> parity x = 1.
proof. by rewrite /dRodd supp_duniform /enumRodd mem_filter mem_enumR. qed.

lemma dRodd_odd (x : Rn) : x \in dRodd => parity x = 1.
proof. by rewrite supp_dRodd. qed.

(* A weight-1 element is odd. *)
lemma enumRodd_nonempty : enumRodd <> [].
proof.
have [x hx] := weight_k_exists 1 _; first smt(gt0_n).
apply/negP => h.
have : x \in dRodd by rewrite supp_dRodd /parity hx.
by rewrite /dRodd supp_duniform h.
qed.

lemma dRodd_ll : is_lossless dRodd.
proof. by rewrite /dRodd duniform_ll enumRodd_nonempty. qed.

lemma dRodd_uni : is_uniform dRodd.
proof. exact duniform_uni. qed.

(* -------------------------------------------------------------------- *)
(* 8. INVERTIBILITY IN Rn                                                *)
(*                                                                       *)
(* An element of Rn whose representative is coprime to the modulus      *)
(* X^n + 1 (= X^n - 1) is a unit. With Phi = 1 + X + ... + X^(n-1),      *)
(* X^n + 1 = (X + 1) * Phi, so if n is odd and Phi is irreducible, every *)
(* odd-weight element of weight < n is a unit (wt_unit_irred).           *)
(* -------------------------------------------------------------------- *)

(* In F2, the only nonzero element is 1. *)
lemma Zp_nz_one (c : Zp.zmod) : c <> Zp.zero => c = Zp.one.
proof.
move=> nz_c; apply Zp.asint_inj.
smt(Zp.rg_asint Zp.oneE Zp.zeroE Zp.asint_inj).
qed.

(* PolyDiv on the polynomials underlying Rn. *)
clone PolyDiv as PD with
  type coeff <- Zp.zmod,
  theory Coeff <- Zp.ZModpRing,
  theory BasePoly <- PR.PolyReduce.BasePoly
proof coeff_field.
realize coeff_field.
proof.
by move=> c /Zp_nz_one ->; exact Zp.ZModpRing.unitr1.
qed.

(* The modulus. *)
op modXn : poly = exp X n + poly1.

lemma pi_modXn : pi modXn = PR.PolyReduce.zeror.
proof.
rewrite /PR.PolyReduce.zeror -eqv_pi eqv0r /I /modXn.
exact PIdeal.mem_idgen1_gen.
qed.

(* Bezout in F2[X], mapped to Rn.

   Performance note: rewriting with the generic ring laws of Rn
   (ComRingDflInv.mulr0, addr0) at this point takes about two minutes,
   because the matcher unfolds the quotient operations down to the
   coefficient sums. congr/exact with explicit instances avoids it. *)
lemma coprime_unit (x : Rn) :
  PD.coprimep (crepr x) modXn => ComRingDflInv.unit x.
proof.
move=> /PD.coprimep_bezout [u v e].
exists (pi u).
have h1 : pi (u * crepr x + v * modXn) = pi u * x.
+ rewrite -(addE (u * crepr x) (v * modXn)) -(mulE u (crepr x)) -(mulE v modXn).
  rewrite (creprK x) pi_modXn.
  apply (eq_trans _ (pi u * x + PR.PolyReduce.zeror)).
  + by congr; exact (ComRingDflInv.mulr0 (pi v)).
  exact (ComRingDflInv.addr0 (pi u * x)).
by rewrite -h1 e.
qed.

(* Characteristic 2 in F2: 1 + 1 = 0. *)
lemma Zp_1p1 : Zp.(+) Zp.one Zp.one = Zp.zero.
proof. by apply Zp.asint_inj; rewrite Zp.addE Zp.oneE Zp.zeroE. qed.

lemma Zp_one_nz : Zp.one <> Zp.zero.
proof. exact Zp.ZModpRing.oner_neq0. qed.

(* Phi = 1 + X + ... + X^(n-1). *)
op phi : poly = polyL (nseq n Zp.one).

lemma phiE (k : int) : phi.[k] = if 0 <= k < n then Zp.one else Zp.zero.
proof. by rewrite /phi polyLE nth_nseq_if. qed.

lemma deg_phi : deg phi = n.
proof.
rewrite /phi degL; last by rewrite size_nseq; smt(gt0_n).
by rewrite last_nseq 1:gt0_n Zp_one_nz.
qed.

lemma modXnE (k : int) :
  modXn.[k] = Zp.(+) (if k = n then Zp.one else Zp.zero)
                     (if k = 0 then Zp.one else Zp.zero).
proof. by rewrite /modXn polyDE polyXnE 1:ge0_n polyCE. qed.

(* X^n + 1 = (X + 1) * Phi. *)
lemma Xp1_phi : (X + poly1) * phi = modXn.
proof.
apply/poly_eqP => k ge0_k.
rewrite PolyComRing.mulrDl PolyComRing.mul1r (PolyComRing.mulrC X phi).
rewrite polyDE polyMXE !phiE modXnE.
smt(gt0_n Zp_1p1 Zp.ZModpRing.add0r Zp.ZModpRing.addr0).
qed.

(* The weight of the class of a reduced polynomial counts its
   coefficients. *)
lemma wt_pi (p : poly) :
  deg p <= n => wt (pi p) = count (fun i => p.[i] <> Zp.zero) (range 0 n).
proof. by move=> hp; rewrite /wt piK 1:reducedP. qed.

lemma wt_phi : wt (pi phi) = n.
proof.
rewrite wt_pi 1:deg_phi //.
have -> : count (fun (i : int) => phi.[i] <> Zp.zero) (range 0 n)
        = count predT (range 0 n).
+ by apply eq_in_count => i /mem_range hi /=; rewrite phiE hi /= Zp_one_nz.
by rewrite count_predT size_range; smt(gt0_n).
qed.

lemma parity_phi : !(2 %| n) => parity (pi phi) = 1.
proof. by rewrite /parity wt_phi; smt(). qed.

lemma deg_Xp1 : deg (X + poly1) = 2.
proof. by rewrite degDl degX ?deg1. qed.

lemma Xp1E (k : int) :
  (X + poly1).[k] = Zp.(+) (if k = 1 then Zp.one else Zp.zero)
                           (if k = 0 then Zp.one else Zp.zero).
proof. by rewrite polyDE polyXE polyCE. qed.

lemma wt_Xp1 : 1 < n => wt (pi (X + poly1)) = 2.
proof.
move=> gt1_n; rewrite wt_pi 1:deg_Xp1 1:/#.
rewrite (range_ltn 0) 1:/# (range_ltn 1) 1:/# /=.
have -> : count (fun (i : int) => (X + poly1).[i] <> Zp.zero) (range 2 n) = 0.
+ have hno : !has (fun (i : int) => (X + poly1).[i] <> Zp.zero) (range 2 n).
  * apply/hasPn => i /mem_range hi /=; rewrite Xp1E.
    smt(Zp.ZModpRing.add0r).
  by smt(has_count count_ge0).
rewrite !Xp1E /=.
smt(Zp.ZModpRing.add0r Zp.ZModpRing.addr0 Zp_one_nz).
qed.

lemma parity_Xp1 : 1 < n => parity (pi (X + poly1)) = 0.
proof. by move=> gt1_n; rewrite /parity wt_Xp1. qed.

(* An element of odd weight is not divisible by X + 1. *)
lemma Xp1_ndvd_odd (p : poly) :
  1 < n => parity (pi p) = 1 => !PD.dvdp (X + poly1) p.
proof.
move=> gt1_n hp; apply/negP => -[s e].
have h1 := parity_mul (pi s) (pi (X + poly1)).
have h2 := parity_Xp1 gt1_n.
have h3 : pi s * pi (X + poly1) = pi p by rewrite mulE e.
smt().
qed.

(* Every polynomial of degree 2 (that is, of mathematical degree 1) is
   irreducible. *)
lemma irred_deg2 (f : poly) : deg f = 2 => PD.irreduciblep f.
proof.
move=> hf; split; first by rewrite hf.
move=> g hg.
have nz_f : f <> poly0 by rewrite -deg_gt0 hf.
have := PD.dvdp_leq g f nz_f hg.
have : g <> poly0 by apply/negP => ->>; move: nz_f; rewrite (PD.dvdp0_eq f hg).
by rewrite -deg_gt0; smt().
qed.

(* A nonzero element of weight < n is not a multiple of Phi: the only
   nonzero multiple of Phi of degree <= n is Phi itself, of weight n. *)
lemma phi_ndvd (x : Rn) : 0 < wt x < n => !PD.dvdp phi (crepr x).
proof.
move=> [gt0_w lt_wn]; apply/negP => -[s e].
have [i [_ hi]] : exists i, i \in range 0 n /\ x.[i] <> Zp.zero.
+ by apply/hasP; rewrite has_count.
have nz_x : crepr x <> poly0 by apply/negP => h; move: hi; rewrite h poly0E.
have nz_s : s <> poly0.
+ by apply/negP => ->>; move: nz_x; rewrite e PolyComRing.mul0r.
have nz_phi : phi <> poly0 by rewrite -deg_gt0 deg_phi gt0_n.
have hdeg := PD.degM s phi nz_s nz_phi.
have hle := deg_crepr x.
have hs1 : deg s = 1 by move: hle; rewrite e hdeg deg_phi; smt(deg_gt0).
have [c [nz_c es]] : exists c, c <> Zp.zero /\ s = polyC c by apply/deg_eq1.
have hx : x = pi phi.
+ by rewrite -creprK e es (Zp_nz_one c nz_c) PolyComRing.mul1r.
by move: lt_wn; rewrite hx wt_phi.
qed.

(* Every odd-weight element of weight < n is a unit, provided n is odd
   and Phi is irreducible over F2. *)
lemma wt_unit_irred (x : Rn) :
  PD.irreduciblep phi => !(2 %| n) =>
  !(2 %| wt x) => wt x < n => ComRingDflInv.unit x.
proof.
move=> irr_phi odd_n odd_x lt_xn.
have gt1_n : 1 < n by have [] := irr_phi; rewrite deg_phi.
apply coprime_unit; rewrite -Xp1_phi.
apply PD.coprime_mul; apply PD.coprimep_sym; apply PD.irred_coprime.
+ by apply irred_deg2; exact deg_Xp1.
+ by apply Xp1_ndvd_odd => //; rewrite creprK /parity; smt().
+ exact irr_phi.
by apply phi_ndvd; smt(wt_ge0).
qed.
